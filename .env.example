# Copy to .env.local for local dev. Never commit real values.
# In Vercel, set these in Project Settings > Environment Variables
# (scope Production / Preview / Development separately).

# Canonical site URL (no trailing slash). Production: https://v3lcode.com (TBC)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact form email provider (names only; provider TBC, e.g. Resend)
# EMAIL_API_KEY=
# CONTACT_TO_EMAIL=
# CONTACT_FROM_EMAIL=

# Sentry (free tier, optional until approved)
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
